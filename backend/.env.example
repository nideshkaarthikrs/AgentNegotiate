# AgentNegotiate Environment Variables
# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# LLM providers
#
# LLM_PROVIDERS is an ordered fallback chain (default: gemini,groq). Each call
# tries them in order; a provider with no key is skipped silently. If every
# provider fails, explanations fall back to deterministic text — the LLM never
# makes a financial decision, so a total outage costs prose, not correctness.
# ---------------------------------------------------------------------------
# LLM_PROVIDERS=gemini,groq

# Gemini — primary. Free key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-3.5-flash-lite).
# Do NOT use gemini-3.5-flash here: it spends its output budget on thinking
# tokens and returns truncated explanations.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Groq — fallback. Free key from https://console.groq.com/keys
# Free tier: 1,000 requests/day and 8,000 tokens/minute per model, which is
# roughly 140 negotiations/day at ~7 LLM calls each. Leave blank to run
# Gemini-only.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model (default: openai/gpt-oss-120b).
# openai/gpt-oss-20b is the smaller alternative, but it leaks internal
# concession percentages into user-facing explanations.
# GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Razorpay Test Keys (from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret — set this when you create the webhook in the
# dashboard. POST /api/webhooks/razorpay verifies the X-Razorpay-Signature
# header against the raw request body with this secret, and rejects the
# request with 400 if it is unset or does not match.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Comma-separated browser origins allowed by CORS
# (default: http://localhost:3000,http://127.0.0.1:3000)
# CORS_ORIGINS=http://localhost:3000

# SQLite path (default: agent_negotiate.db)
# DATABASE_PATH=agent_negotiate.db
